NODE_ENV=development
PORT=5001

# Use "localhost" when running the backend on your machine, "postgres" inside docker-compose
DATABASE_URL=postgresql://admin:password@localhost:5432/analytics?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters and DIFFERENT from each other.
JWT_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

BCRYPT_ROUNDS=12

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
